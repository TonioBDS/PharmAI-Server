# Copiez ce fichier en .env et changez le mot de passe.
POSTGRES_PASSWORD=changez-moi
# Port exposé sur la machine hôte
PORT=8080
# true : n'importe quel appareil peut créer un foyer. Passez à false une fois vos foyers créés ;
# les nouveaux appareils rejoignent alors uniquement par invitation.
ALLOW_REGISTRATION=true
LOG_LEVEL=info
