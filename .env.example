# Facultatif : copiez ce fichier en .env pour changer les réglages.
# Port exposé sur la machine hôte
PORT=8080
# true : n'importe quel appareil peut créer un foyer. Passez à false une fois votre foyer créé ;
# les nouveaux téléphones rejoignent alors uniquement par invitation validée.
ALLOW_REGISTRATION=true
LOG_LEVEL=info
# Variante PostgreSQL uniquement (docker-compose.postgres.yml)
POSTGRES_PASSWORD=changez-moi
